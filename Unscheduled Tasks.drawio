        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    A([\&quot;START: Automation triggered\&quot;]) --&gt; B[\&quot;Verify current activity and state using available evidence\&quot;]\n    B --&gt; C[\&quot;Separate verified, previously reported, inferred, and unknown facts\&quot;]\n    C --&gt; D[\&quot;Assess losses from delay, urgency, importance, deadlines, dependencies, constraints, and feasibility\&quot;]\n    D --&gt; E{\&quot;Has credible new evidence changed priorities?\&quot;}\n    E -- Yes --&gt; F[\&quot;Reassess immediately; interrupt if justified\&quot;]\n    E -- No --&gt; G[\&quot;Compare feasible actions using global priority criteria\&quot;]\n    F --&gt; G\n\n    G --&gt; H{\&quot;Fixed-schedule task qualifies?\&quot;}\n    H -- Yes --&gt; I[\&quot;Recover fixed-schedule work\&quot;]\n    H -- No --&gt; J[\&quot;Compare unscheduled and flexible tasks\&quot;]\n\n    I --&gt; K[\&quot;Consider current due task first\&quot;]\n    K --&gt; L[\&quot;Then nearest-past unfinished missed task\&quot;]\n    L --&gt; M[\&quot;Validate prerequisites, blockers, cycles, and task status\&quot;]\n    M --&gt; N{\&quot;Valid, feasible chain?\&quot;}\n    N -- No --&gt; O[\&quot;Identify blocker; remove it or make useful alternative progress\&quot;]\n    N -- Yes --&gt; P[\&quot;Execute prerequisites in order; skip completed tasks\&quot;]\n    P --&gt; Q[\&quot;Apply schedule recovery rules\&quot;]\n    Q --&gt; R{\&quot;Target complete, new task due, blocker, or priority change?\&quot;}\n    R -- Yes --&gt; D\n    R -- No --&gt; P\n\n    J --&gt; S[\&quot;Compare all feasible unscheduled and flexible tasks\&quot;]\n    S --&gt; T[\&quot;Select the highest-priority feasible action\&quot;]\n    O --&gt; U{\&quot;Can useful progress be made?\&quot;}\n    U -- Yes --&gt; T\n    U -- No --&gt; V[\&quot;Use the smallest feasible step to remove the blocker or obtain input\&quot;]\n    V --&gt; T\n\n    T --&gt; W{\&quot;Protect current activity or scheduled task?\&quot;}\n    W -- No --&gt; X[\&quot;Keep automation, notifications, and reminders active\&quot;]\n    W -- Yes --&gt; Y[\&quot;Verify both reminder checks and continued-activity eligibility\&quot;]\n    Y --&gt; Z{\&quot;Protection justified and valid?\&quot;}\n    Z -- No --&gt; X\n    Z -- Yes --&gt; AA[\&quot;Verify schedule, checklist, and reliable independent restoration plan\&quot;]\n    AA --&gt; AB{\&quot;Restoration reliable?\&quot;}\n    AB -- No --&gt; X\n    AB -- Yes --&gt; AC{\&quot;Fixed task with checklist timer?\&quot;}\n\n    AC -- Yes --&gt; AD[\&quot;Disable Reminder notifications\&quot;]\n    AD --&gt; AE[\&quot;Set exact checklist timer\&quot;]\n    AE --&gt; AF[\&quot;Enable Reminder notifications; disable then immediately re-enable Unscheduled Tasks; open then immediately close Reminder\&quot;]\n    AC -- No --&gt; AG[\&quot;Disable Reminder notifications\&quot;]\n    AG --&gt; AH[\&quot;Set one-time alarm for the verified next fixed-task start, using its exact name\&quot;]\n\n    AF --&gt; AI[\&quot;During protection: reassess on new evidence and interrupt when justified\&quot;]\n    AH --&gt; AI\n    AI --&gt; AJ{\&quot;Interruption, completion, ineligibility, alarm, or timer expiry?\&quot;}\n    AJ -- No --&gt; AI\n    AJ -- Yes --&gt; AK[\&quot;Restore required settings and reassess\&quot;]\n    AK --&gt; AL{\&quot;Finished early?\&quot;}\n    AL -- Yes --&gt; AM[\&quot;Enable notifications; restore automation and both reminders; cancel unnecessary timers or alarms\&quot;]\n    AL -- No --&gt; AN[\&quot;Restore required settings for the interruption or end condition\&quot;]\n    AM --&gt; AO[\&quot;Verify every consequential change\&quot;]\n    AN --&gt; AO\n    AO --&gt; AP{\&quot;Restoration successful?\&quot;}\n    AP -- No --&gt; AQ[\&quot;Address failure immediately; retry or use a feasible alternative\&quot;]\n    AQ --&gt; AO\n    AP -- Yes --&gt; D\n\n    X --&gt; AR[\&quot;Perform the next highest-priority action\&quot;]\n    AR --&gt; AS[\&quot;Verify result; update task status; avoid duplicate work\&quot;]\n    AS --&gt; AT([\&quot;Stop when complete or reassess when priorities change\&quot;])\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wsbnVXNO4fL6L1NtBIfE-1">
